# Copy to .env (local) or add these in your host's environment settings (Vercel). Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=false
ALLOWED_ORIGINS=

# Where accounts and library details are stored: "sqlite" (local file) or "github" (JSON in a PRIVATE GitHub repo; use this on Vercel)
STORAGE_DRIVER=sqlite
SQLITE_PATH=./data/jupiter.db
SESSION_TTL_HOURS=168

# First admin, created only when there are no users yet. Remove the password after first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Random secret (64 hex chars): signs upload tickets. Generate: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=

# ---- github storage (only when STORAGE_DRIVER=github) ----
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=jupiter-data
GITHUB_DATA_PATH=jupiter-data.json

# ---- public sign-up ----
SIGNUP_ENABLED=true
SIGNUP_ROLE=member

# ---- music storage ----
JUPITER_MEDIA_REPO=
JUPITER_MEDIA_BRANCH=jupiter-media
JUPITER_MEDIA_TOKEN=
JUPITER_MEDIA_DRIVER=
JUPITER_MEDIA_DIR=./data/jupiter-media
JUPITER_SECRET=
JUPITER_MAX_FILE_MB=200
JUPITER_LIBRARY_LIMIT_MB=900
CRON_SECRET=
